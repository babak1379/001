<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widgetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layoutDirection="rtl"
    android:background="@drawable/widget_outline"
    android:padding="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:layoutDirection="rtl"
        android:gravity="center_vertical">
        <TextView android:id="@+id/weekdayText" android:layout_width="88dp" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:text="شنبه" android:textColor="#FFFFFFFF" android:textSize="18sp" android:textStyle="bold"/>
        <TextView android:id="@+id/clockText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:singleLine="true" android:text="14:35" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"/>
    </LinearLayout>

    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:layoutDirection="rtl">
        <TextView android:id="@+id/pDay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۲" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/pMonthNum" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۸" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/pYear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۱۴۰۵" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/pMonth" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="مرداد" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:layoutDirection="rtl">
        <TextView android:id="@+id/gDay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۲۴" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/gMonthNum" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۸" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/gYear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۲۰۲۶" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/gMonth" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="اوت" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal" android:layoutDirection="rtl">
        <TextView android:id="@+id/hDay" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۱۴" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/hMonthNum" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="0.7" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۲" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/hYear" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.15" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="۱۴۴۸" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
        <TextView android:id="@+id/hMonth" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1.35" android:gravity="center" android:singleLine="true" android:background="@drawable/widget_cell" android:padding="2dp" android:text="صفر" android:textColor="#FFFFFFFF" android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>