<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widgetRoot" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="2dp" android:background="@android:color/transparent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="56dp" android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/widget_outline" android:paddingStart="8dp" android:paddingEnd="8dp">
        <TextView android:id="@+id/clockText" android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1" android:gravity="center" android:singleLine="true" android:text="14:35" android:textColor="#FFFFFFFF" android:textSize="30sp" android:textStyle="bold"/>
        <View android:layout_width="1dp" android:layout_height="36dp" android:background="#CCFFFFFF"/>
        <TextView android:id="@+id/weekdayText" android:layout_width="88dp" android:layout_height="match_parent" android:gravity="center" android:singleLine="true" android:text="شنبه" android:textColor="#FFFFFFFF" android:textSize="20sp" android:textStyle="bold"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:orientation="vertical" android:background="@drawable/widget_outline">
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
            <TextView android:id="@+id/pMonth" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.35" android:text="مرداد"/>
            <TextView android:id="@+id/pYear" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.15" android:text="۱۴۰۵"/>
            <TextView android:id="@+id/pMonthNum" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۸"/>
            <TextView android:id="@+id/pDay" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۲"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
            <TextView android:id="@+id/gMonth" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.35" android:text="اوت"/>
            <TextView android:id="@+id/gYear" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.15" android:text="۲۰۲۶"/>
            <TextView android:id="@+id/gMonthNum" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۸"/>
            <TextView android:id="@+id/gDay" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۲۴"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:orientation="horizontal">
            <TextView android:id="@+id/hMonth" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.35" android:text="صفر"/>
            <TextView android:id="@+id/hYear" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="1.15" android:text="۱۴۴۸"/>
            <TextView android:id="@+id/hMonthNum" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۲"/>
            <TextView android:id="@+id/hDay" style="@style/DateCell" android:layout_width="0dp" android:layout_weight="0.7" android:text="۱۴"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
